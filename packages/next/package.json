{
  "name": "@vperms/next",
  "version": "0.0.0",
  "description": "Next.js integration for VeguiPerms.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VeguiDev/VeguiPerms.git",
    "directory": "packages/next"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun run test:client && bun run test:server",
    "test:client": "bun test tests/client.test.tsx",
    "test:server": "bun test --conditions=react-server tests/server.test.tsx tests/external.test.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vperms/client": "workspace:*",
    "@vperms/react": "workspace:*",
    "vperms": "workspace:*"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
