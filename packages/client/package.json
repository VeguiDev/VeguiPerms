{
  "name": "@vperms/client",
  "version": "0.0.0",
  "description": "Framework-independent VeguiPerms client for resolved permissions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VeguiDev/VeguiPerms.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:dts",
    "build:js": "bun build src/index.ts --outdir dist --format esm --target node --packages external",
    "build:dts": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "vperms": "workspace:*"
  }
}
